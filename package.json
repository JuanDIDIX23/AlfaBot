{
  "name": "alfabot-inferencia",
  "version": "1.0.0",
  "description": "AlfaBot: motor de inferencia bayesiano a tres capas para el diagnóstico de alfabetización de adultos",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/presentacion/web/servidor.js",
    "desarrollo": "tsx src/presentacion/web/servidor.ts",
    "consola": "tsx src/presentacion/main.ts",
    "pruebas": "tsx src/pruebas/ejecutarPruebas.ts",
    "pruebas:api": "tsx src/pruebas/pruebasApi.ts",
    "pruebas:aprendizaje": "tsx src/pruebas/pruebasAprendizaje.ts",
    "cargar-bd": "tsx tools/cargar_bd.ts",
    "construir": "tsc -p tsconfig.build.json",
    "compilar": "tsc --noEmit",
    "empaquetar": "tsx tools/empaquetar.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "adm-zip": "^0.6.1",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
