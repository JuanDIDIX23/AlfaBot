digraph DFD0 {
  bgcolor="#FAF7F1";
  rankdir=TB;
  nodesep=0.9;
  ranksep=1.3;
  node [fontname="Helvetica", fontsize=14];
  edge [fontname="Helvetica", fontsize=12, color="#5B6560", fontcolor="#3C443F", arrowsize=0.9, penwidth=1.4];

  usuario [shape=box, style="filled", fillcolor="#1E2A24", fontcolor="white", color="#1E2A24", margin="0.3,0.2",
           label="Usuario\n(adulto en proceso de\nalfabetización)"];

  p0 [shape=box, style="rounded,filled", fillcolor="white", color="#3E7C72", penwidth=2, margin="0.3,0.25",
      label=<<b>0</b><br/><b>Sistema de inferencia</b><br/><b>AlfaBot</b>>];

  d1 [shape=none, margin=0, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="9">
        <tr><td sides="TB" border="1" bgcolor="#E4EFEC" color="#3E7C72"><b>D1</b></td>
            <td sides="TB" border="1" bgcolor="#E4EFEC" color="#3E7C72">Base de conocimiento</td></tr></table>>];
  d2 [shape=none, margin=0, label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="9">
        <tr><td sides="TB" border="1" bgcolor="#FDEEE3" color="#C1652F"><b>D2</b></td>
            <td sides="TB" border="1" bgcolor="#FDEEE3" color="#C1652F">Base transaccional</td></tr></table>>];

  usuario -> p0 [label="alias y respuestas", color="#1E2A24"];
  p0 -> usuario [label="preguntas, probabilidades,\ndiagnóstico y plan", color="#1E2A24"];
  d1 -> p0 [label="hipótesis, nodos, ramas,\nreglas y verosimilitudes", color="#3E7C72", fontcolor="#3E7C72"];
  p0 -> d2 [label="usuario, respuestas, inferencias,\ndiagnóstico y progreso", color="#C1652F", fontcolor="#C1652F"];
  {rank=same; d1; d2;}
}
