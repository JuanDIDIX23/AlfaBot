# AlfaBot — variables de entorno.
# OJO: la aplicación NO lee este archivo sola. Defínelas en la terminal o, en Azure, como ajustes de la aplicación.

# Opción A: una sola cadena de conexión
DATABASE_URL=postgres://alfabot:alfabot@localhost:5432/alfabot

# Opción B: por separado (ejemplo para Azure)
# PGHOST=alfabot-pg-SUFIJO.postgres.database.azure.com
# PGPORT=5432
# PGUSER=alfabot_app
# PGPASSWORD=
# PGDATABASE=alfabot

# true = conexión cifrada (necesario en Azure y Supabase); verify = cifrada y verifica el certificado
# PGSSL=true

# Solo al ejecutar `npm run cargar-bd`: crea el rol alfabot_app con esta clave (mínimo 12 caracteres)
# ALFABOT_APP_PASSWORD=

# Puerto del servidor web (Azure lo define solo)
# PORT=3000
